<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.ajeaglerman" name="AJeagler Kodi Repo" version="1.0.0" provider-name="you">
	<requires>
		<import addon="xbmc.addon" version="12.0.0"/>
	</requires>
	<extension point="xbmc.addon.repository" name="My Kodi Repo">
		<dir>
			<info compressed="false">https://raw.githubusercontent.com/AJeagler/ajeaglerman-kodi-repo/main/addons.xml</info>
			<checksum>https://raw.githubusercontent.com/AJeagler/ajeaglerman-kodi-repo/main/addons.xml.md5</checksum>
			<datadir zip="true">https://raw.githubusercontent.com/AJeagler/ajeaglerman-kodi-repo/main</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">My personal Kodi addon repository</summary>
		<description lang="en_GB">Hosts my own selection of Kodi addons.</description>
		<platform>all</platform>
	</extension>
</addon>
